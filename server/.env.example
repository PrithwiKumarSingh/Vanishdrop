NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/VanishDrop
MAX_FILE_SIZE_MB=10
FILE_EXPIRATION_HOURS=12
DELETE_LOCK_MINUTES=5
UPLOAD_RATE_LIMIT=10
UPLOAD_RATE_LIMIT_WINDOW_MS=3600000
REQUEST_RATE_LIMIT=240
REQUEST_RATE_LIMIT_WINDOW_MS=900000
DOWNLOAD_RATE_LIMIT=120
DOWNLOAD_RATE_LIMIT_WINDOW_MS=3600000
STORAGE_PROVIDER=supabase
LOCAL_STORAGE_PATH=./uploads
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET=VanishDrop-files
CLIENT_URL=http://localhost:5173
TOKEN_SECRET=replace-with-a-long-random-secret
